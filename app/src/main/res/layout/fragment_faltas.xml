<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:fillViewport="true"
    android:isScrollContainer="true"
    android:id="@+id/scrollFaltas">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚖️ FALTAS E INFRACCIONES"
            android:textColor="#33BB66"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="16dp"/>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Seleccionar Falta"
            android:layout_marginBottom="8dp">
            <AutoCompleteTextView
                android:id="@+id/autoCompleteFaltas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:singleLine="true"
                android:completionThreshold="1"/>
        </com.google.android.material.textfield.TextInputLayout>

       <!-- <Button
            android:id="@+id/btnAgregarFalta"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="➕ AGREGAR FALTA AL ACTA"
            android:layout_marginBottom="16dp"/>*/-->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Faltas seleccionadas:"
            android:textStyle="bold"
            android:textSize="14sp"/>

        <LinearLayout
            android:id="@+id/contenedorListaFaltas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp">
            <TextView
                android:id="@+id/tvSinFaltas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No hay faltas seleccionadas"
                android:textColor="#999999"
                android:fontStyle="italic" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Descripcion de la Falta:"
            android:textStyle="bold"
            android:textSize="14sp"/>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/ftObservaciones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lines="3"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:imeOptions="actionNext" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="3">
            <Button
                android:id="@+id/btnVolverFaltas"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:text="VOLVER"
                android:layout_marginEnd="8dp"/>
            <Button
                android:id="@+id/btnSiguienteFaltas"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="2"
                android:text="SIGUIENTE:  ⮕"
                android:backgroundTint="#33BB66"/>
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="300dp" />
    </LinearLayout>
</ScrollView>