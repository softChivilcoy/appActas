<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- VISTA 1: PREPARACIÓN (Solo la ve el Inspector) -->
    <LinearLayout
        android:id="@+id/layoutPreparacionFirma"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✍️ CIERRE DE ACTA"
            android:textColor="#33BB66"
            android:textStyle="bold"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Revise los datos antes de pasar al modo firma."
            android:textSize="18sp"
            android:layout_marginBottom="16dp"/>


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Seleccione quién va a firmar:"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="#33BB66"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp"/>

        <!-- Contenedor para botones dinámicos con opción de borrado -->
        <LinearLayout
            android:id="@+id/containerBotonesFirmas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">
            <!-- Se poblará dinámicamente desde el Fragment -->
        </LinearLayout>

        <CheckBox
            android:id="@+id/checkSeNiegaAFirmar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="El infractor se niega a firmar"
            android:textSize="16sp"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnIrAFirmar"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="SIGUIENTE"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#33BB66"
            android:textColor="@android:color/white"
            app:icon="@drawable/ic_signature"
            app:iconTint="@android:color/white" />
        <!-- ic_signature sería un icono de una lapicera -->

    </LinearLayout>

    <!-- VISTA 2: MODO CONFORMIDAD (La ve el Infractor) -->
    <LinearLayout
        android:id="@+id/layoutModoFirma"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#FFFFFF"
        android:visibility="invisible">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📝 RESUMEN DE INFRACCIÓN"
            android:textStyle="bold"
            android:textSize="18sp"
            android:gravity="center"
            android:textColor="#33BB66"/>

        <!-- Mini Resumen para validez legal -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#F1F3F4"
            app:cardElevation="0dp"
            android:layout_marginVertical="8dp">
            <TextView
                android:id="@+id/tvResumenActa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:text="Cargando datos..."
                android:textColor="#333333"
                android:textSize="13sp" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Al firmar, usted se da por notificado de la presente infracción. La firma no implica aceptación de la culpa, sino recepción de la notificación."
            android:textSize="11sp"
            android:textStyle="italic"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnVolverDeFirma"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VOLVER"
            app:icon="@drawable/ic_arrow_back_thin"
            app:iconGravity="textStart"
            android:layout_gravity="start"
            android:layout_marginBottom="4dp"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:strokeColor="#000000"
            app:strokeWidth="2dp"
            app:cardBackgroundColor="#FFFFFF">

            <com.github.gcacace.signaturepad.views.SignaturePad
                android:id="@+id/signaturePad"
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:background="@android:color/white"
                android:saveEnabled="false"/>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/btnLimpiarFirma"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BORRAR"
                android:textColor="#B71C1C" />

            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>

            <Button
                android:id="@+id/btnFinalizarActa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CONFIRMAR FIRMA"
                android:enabled="false"
                android:visibility="gone"
                android:backgroundTint="#33BB66"
                android:textColor="@android:color/white"
                android:layout_marginTop="16dp"/>
        </LinearLayout>

    </LinearLayout>
</FrameLayout>