<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootHojaRuta"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/windowBackground"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clickable="true">

    <!-- Cabecera con Título y Botón Nueva Acta -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:padding="12dp"
        android:elevation="2dp">

        <TextView
            android:id="@+id/tvTituloHoja"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:text="📂 HOJA DE RUTA"
            android:textColor="#33BB66"
            android:textSize="18sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNuevaActa"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="NUEVA ACTA"
            android:textSize="12sp"
            app:icon="@drawable/ic_add"
            android:backgroundTint="?attr/colorPrimary"
            app:iconTint="@android:color/white"
            android:textColor="?attr/colorOnPrimary"
            app:cornerRadius="8dp" />
    </RelativeLayout>

    <!-- Barra de Búsqueda -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilBuscar"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:hint="Buscar por Acta, Fecha o Persona..."
        app:startIconDrawable="@android:drawable/ic_menu_search"
        app:endIconMode="clear_text">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etBuscar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Contenedor Principal (Lista y Empty State) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Lista de Actas -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvHojaRuta"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="8dp"
            android:clipToPadding="false"
            android:focusable="true"
            android:focusableInTouchMode="true" />

        <!-- 🚀 Estado Vacío (Empty State) -->
        <LinearLayout
            android:id="@+id/layoutEmptyState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@android:drawable/ic_menu_agenda"
                app:tint="#33BB66"
                android:alpha="0.5" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="No tenés borradores pendientes"
                android:textColor="#333333"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Presioná '+ NUEVA ACTA' para comenzar"
                android:textColor="#777777"
                android:textSize="14sp" />
        </LinearLayout>

    </FrameLayout>

</LinearLayout>