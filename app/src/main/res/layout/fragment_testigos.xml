<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootTestigos"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true"
    android:background="?android:attr/windowBackground">

    <ScrollView
        android:id="@+id/scrollTestigos"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:padding="12dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/contenedorPrincipalTestigos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp"
            android:focusable="true"
            android:focusableInTouchMode="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👥 TESTIGOS DEL HECHO"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold"
                android:textSize="20sp"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ingrese los datos de los testigos (opcional):"
                android:textSize="15sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:layout_marginBottom="16dp"/>

            <Button
                android:id="@+id/btnAgregarTestigo"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="➕ AGREGAR TESTIGO"
                android:textColor="?attr/colorPrimary"
                app:strokeColor="?attr/colorPrimary"
                android:layout_marginBottom="16dp"
                android:textSize="16sp"/>

            <Button
                android:id="@+id/btnEscanearDniTestigo"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="📷 ESCANEAR QR DNI"
                android:textColor="?attr/colorPrimary"
                app:strokeColor="?attr/colorPrimary"
                app:strokeWidth="1dp"
                app:cornerRadius="8dp"
                android:layout_marginBottom="16dp"
                android:visibility="gone"
                app:icon="@android:drawable/ic_menu_camera"
                app:iconTint="?attr/colorPrimary"/>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTestigo1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardElevation="2dp"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Testigo 1"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorPrimary"
                            android:layout_centerVertical="true"/>

                        <ImageButton
                            android:id="@+id/btnEliminarTestigo1"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_alignParentEnd="true"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@android:drawable/ic_menu_close_clear_cancel"
                            app:tint="?attr/colorError"
                            android:contentDescription="Eliminar testigo" />
                    </RelativeLayout>

                    <!-- DNI y APELLIDO Y NOMBRE -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="DNI"
                            android:layout_marginEnd="8dp"
                            app:errorEnabled="false">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etTestigo1Dni"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:imeOptions="actionNext"
                                android:singleLine="true"
                                android:textSize="16sp"
                                android:selectAllOnFocus="true" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.8"
                            android:hint="Nombre completo">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etTestigo1Nombre"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textCapWords|textNoSuggestions|textVisiblePassword"
                                android:imeOptions="actionNext"
                                android:singleLine="true"
                                android:textSize="16sp"
                                android:selectAllOnFocus="true"/>
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <!-- 1. CALLE Y NRO -->
                    <LinearLayout
                        android:id="@+id/layoutCamposDomicilio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="3"
                        android:layout_marginBottom="12dp">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilCalle"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:hint="Calle"
                            android:layout_marginEnd="8dp">

                            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                android:id="@+id/etTestigo1Calle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:completionThreshold="1"
                                android:dropDownHeight="wrap_content"
                                android:inputType="textCapCharacters|textNoSuggestions|textVisiblePassword"
                                android:imeOptions="actionNext"
                                android:nextFocusDown="@id/etTestigo1CalleNro"
                                android:singleLine="true"
                                android:textSize="16sp"
                                android:selectAllOnFocus="true"/>

                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Nro">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etTestigo1CalleNro"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:imeOptions="actionNext"
                                android:singleLine="true"
                                android:textSize="16sp"
                                android:selectAllOnFocus="true" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <!-- 2. UBICACIÓN SECUNDARIA -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardUbicacionTestigo1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Widget.Material3.CardView.Outlined"
                        app:cardBackgroundColor="?attr/colorSurfaceVariant"
                        android:clickable="true"
                        android:focusable="true">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="12dp"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@android:drawable/ic_dialog_map"
                                app:tint="?attr/colorPrimary"
                                android:contentDescription="Ubicación"
                                android:layout_marginEnd="12dp"/>

                            <TextView
                                android:id="@+id/tvUbicacionResumenT1"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="CHIVILCOY, BUENOS AIRES (CP 6620)"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="?attr/colorOnSurfaceVariant"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="CAMBIAR"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="?attr/colorPrimary"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- 3. DESPLEGABLE OCULTO -->
                    <LinearLayout
                        android:id="@+id/containerUbicacionExtraTestigo1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:layout_marginTop="12dp">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="País"
                            android:layout_marginBottom="8dp">

                            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                android:id="@+id/autoCompleteTestigo1Pais"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textCapCharacters|textNoSuggestions|textVisiblePassword"
                                android:text="ARGENTINA"
                                android:singleLine="true"
                                android:textSize="16sp"
                                android:selectAllOnFocus="true" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Provincia"
                            android:layout_marginBottom="8dp">

                            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                android:id="@+id/autoCompleteTestigo1Provincia"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textCapCharacters|textNoSuggestions|textVisiblePassword"
                                android:text="BUENOS AIRES"
                                android:singleLine="true"
                                android:textSize="16sp"
                                android:selectAllOnFocus="true" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:weightSum="3">

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="2"
                                android:hint="Localidad"
                                android:layout_marginEnd="8dp">

                                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                    android:id="@+id/autoCompleteTestigo1Localidad"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="textCapCharacters|textNoSuggestions|textVisiblePassword"
                                    android:text="CHIVILCOY"
                                    android:singleLine="true"
                                    android:textSize="16sp"
                                    android:selectAllOnFocus="true" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:hint="C.P.">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etTestigo1Cp"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="number"
                                    android:text="6620"
                                    android:singleLine="true"
                                    android:textSize="16sp"
                                    android:imeOptions="actionDone"
                                    android:selectAllOnFocus="true"/>
                            </com.google.android.material.textfield.TextInputLayout>

                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- TESTIGO 2 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTestigo2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardElevation="2dp"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Testigo 2"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorPrimary"
                            android:layout_centerVertical="true"/>

                        <ImageButton
                            android:id="@+id/btnEliminarTestigo2"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_alignParentEnd="true"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@android:drawable/ic_menu_close_clear_cancel"
                            app:tint="?attr/colorError"
                            android:contentDescription="Eliminar testigo" />
                    </RelativeLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="DNI"
                            android:layout_marginEnd="8dp"
                            app:errorEnabled="false">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etTestigo2Dni"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:imeOptions="actionNext"
                                android:singleLine="true"
                                android:textSize="16sp"
                                android:selectAllOnFocus="true"/>
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.8"
                            android:hint="Nombre completo">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etTestigo2Nombre"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textCapWords|textNoSuggestions|textVisiblePassword"
                                android:imeOptions="actionNext"
                                android:singleLine="true"
                                android:textSize="16sp"
                                android:selectAllOnFocus="true"/>
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>


                    <!-- 1. CALLE Y NRO -->
                    <LinearLayout
                        android:id="@+id/layoutCamposDomicilioT2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="3"
                        android:layout_marginBottom="12dp">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilCalleT2"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:hint="Calle"
                            android:layout_marginEnd="8dp">

                            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                android:id="@+id/etTestigo2Calle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:completionThreshold="1"
                                android:dropDownHeight="wrap_content"
                                android:inputType="textCapCharacters|textNoSuggestions|textVisiblePassword"
                                android:imeOptions="actionNext"
                                android:nextFocusDown="@id/etTestigo2CalleNro"
                                android:singleLine="true"
                                android:textSize="16sp"
                                android:selectAllOnFocus="true"/>

                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Nro">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etTestigo2CalleNro"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:imeOptions="actionNext"
                                android:singleLine="true"
                                android:textSize="16sp"
                                android:selectAllOnFocus="true" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <!-- 2. UBICACIÓN SECUNDARIA -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardUbicacionTestigo2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Widget.Material3.CardView.Outlined"
                        app:cardBackgroundColor="?attr/colorSurfaceVariant"
                        android:clickable="true"
                        android:focusable="true">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="12dp"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@android:drawable/ic_dialog_map"
                                app:tint="?attr/colorPrimary"
                                android:contentDescription="Ubicación"
                                android:layout_marginEnd="12dp"/>

                            <TextView
                                android:id="@+id/tvUbicacionResumenT2"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="CHIVILCOY, BUENOS AIRES (CP 6620)"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="?attr/colorOnSurfaceVariant"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="CAMBIAR"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="?attr/colorPrimary"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- 3. DESPLEGABLE OCULTO -->
                    <LinearLayout
                        android:id="@+id/containerUbicacionExtraTestigo2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:layout_marginTop="12dp">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="País"
                            android:layout_marginBottom="8dp">

                            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                android:id="@+id/autoCompleteTestigo2Pais"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textCapCharacters|textNoSuggestions|textVisiblePassword"
                                android:text="ARGENTINA"
                                android:singleLine="true"
                                android:textSize="16sp"
                                android:selectAllOnFocus="true"/>
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Provincia"
                            android:layout_marginBottom="8dp">

                            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                android:id="@+id/autoCompleteTestigo2Provincia"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textCapCharacters|textNoSuggestions|textVisiblePassword"
                                android:text="BUENOS AIRES"
                                android:singleLine="true"
                                android:textSize="16sp"
                                android:selectAllOnFocus="true"/>
                        </com.google.android.material.textfield.TextInputLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:weightSum="3">

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="2"
                                android:hint="Localidad"
                                android:layout_marginEnd="8dp">

                                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                    android:id="@+id/autoCompleteTestigo2Localidad"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="textCapCharacters|textNoSuggestions|textVisiblePassword"
                                    android:text="CHIVILCOY"
                                    android:singleLine="true"
                                    android:textSize="16sp"
                                    android:selectAllOnFocus="true"/>
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:hint="C.P.">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etTestigo2Cp"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="number"
                                    android:text="6620"
                                    android:singleLine="true"
                                    android:textSize="16sp"
                                    android:imeOptions="actionDone"
                                    android:selectAllOnFocus="true"/>
                            </com.google.android.material.textfield.TextInputLayout>

                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <Space
                android:layout_width="match_parent"
                android:layout_height="80dp" />
        </LinearLayout>
    </ScrollView>

    <!-- BOTONES FIJOS ABAJO -->
    <LinearLayout
        android:id="@+id/bottomContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/windowBackground"
        android:elevation="16dp"
        android:orientation="horizontal"
        android:padding="12dp"
        android:weightSum="3"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <Button
            android:id="@+id/btnVolverTestigos"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="VOLVER"
            android:textSize="14sp"
            app:icon="@drawable/ic_arrow_back_thin"
            app:iconGravity="textStart" />

        <Button
            android:id="@+id/btnSiguienteTestigos"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="2"
            android:backgroundTint="?attr/colorPrimary"
